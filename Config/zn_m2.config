# =============================================================================
#  ZN-M2 旁路由 —— 极简稳定版
#  「系统 + OpenClash + NSS」+ 必要的诊断/恢复工具，其他全砍
#
#  决策依据（用户已确认）：
#    - 砍 WiFi：省 ~30MB 内存（家用 WiFi 由联通 FTTR 提供）
#    - 长期稳定优先：保留 opkg / SSH / htop / sftp
#    - OpenClash 全局模式，不装 GeoIP/GeoSite
#    - iPhone 严格零直连：关 IPv6 + fake-ip
#    - 保留 NSS 硬件加速全部组件
# =============================================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_PROFILE="DEVICE_zn_m2"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2=""

CONFIG_CCACHE=y

# =============================================================================
#  LuCI（最小可用 + 中文）
# =============================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# =============================================================================
#  OpenClash 全套依赖（缺一不可）
# =============================================================================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y

# 防火墙（nftables 后端，OpenClash 依赖）
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# mihomo (musl 静态或动态都需要的运行库)
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libstdcpp=y

# =============================================================================
#  诊断 + 恢复工具（长期稳定优先，这几个留着）
# =============================================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-keygen=y

# =============================================================================
#  砍掉 WiFi 全套 —— 旁路由走网线，不需要发 WiFi
#  这是最大的省内存项（约 30MB）
# =============================================================================
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-basic=n
CONFIG_PACKAGE_wpad-mini=n
CONFIG_PACKAGE_wpad-mesh-openssl=n
CONFIG_PACKAGE_wpad-mesh-wolfssl=n
CONFIG_PACKAGE_wpad-mesh-mbedtls=n
# wpad 虚拟包本身（PROVIDES:=hostapd wpa-supplicant，LibWrt 的 wpad-full-internal variant 编不过）
CONFIG_PACKAGE_wpad=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_hostapd-mini=n
CONFIG_PACKAGE_hostapd-basic=n
CONFIG_PACKAGE_hostapd-basic-mbedtls=n
CONFIG_PACKAGE_hostapd-basic-openssl=n
CONFIG_PACKAGE_hostapd-basic-wolfssl=n
CONFIG_PACKAGE_hostapd-utils=n
CONFIG_PACKAGE_wpa-cli=n
CONFIG_PACKAGE_wpa-supplicant=n
CONFIG_PACKAGE_wpa-supplicant-openssl=n
CONFIG_PACKAGE_wpa-supplicant-mbedtls=n
CONFIG_PACKAGE_wpa-supplicant-basic=n
CONFIG_PACKAGE_wpa-supplicant-mini=n
CONFIG_PACKAGE_eapol-test=n
# WiFi 驱动 + 固件 + 工具
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-mac80211=n
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_wireless-regdb=n
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iwinfo=n
CONFIG_PACKAGE_luci-iwinfo=n
CONFIG_PACKAGE_luci-app-wireless=n
# rpcd-mod-iwinfo 是 luci-mod-status 的依赖，但只读接口信息，留着无害且很小
# 注意：不要关 luci-mod-network / luci-mod-status / luci-mod-system

# =============================================================================
#  砍掉无关 PHY（M2 是 QCA8075 千兆，不是 10G）
# =============================================================================
CONFIG_PACKAGE_kmod-phy-aquantia=n
CONFIG_PACKAGE_kmod-phy-marvell=n
CONFIG_PACKAGE_kmod-phy-marvell-10g=n
CONFIG_PACKAGE_kmod-phy-realtek=n
CONFIG_PACKAGE_kmod-phy-broadcom=n
CONFIG_PACKAGE_kmod-phy-smsc=n
CONFIG_PACKAGE_kmod-phy-ax88796b=n
# M2 使用 QCA8075，不能误裁 AT803x/QCA807x 系列 PHY 驱动。
# 不写 kmod-phy-at803x=n。

# =============================================================================
#  砍掉 USB 全套（旁路由不需要）
# =============================================================================
CONFIG_PACKAGE_kmod-usb3=n
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb-xhci-hcd=n
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-storage-extras=n
CONFIG_PACKAGE_kmod-usb2=n

# =============================================================================
#  砍掉文件系统工具（不挂 U 盘/不格式化）
# =============================================================================
CONFIG_PACKAGE_e2fsprogs=n
CONFIG_PACKAGE_f2fs-tools=n
CONFIG_PACKAGE_losetup=n
CONFIG_PACKAGE_kmod-fs-ext4=n
CONFIG_PACKAGE_kmod-fs-f2fs=n
CONFIG_PACKAGE_kmod-fs-nfs=n
CONFIG_PACKAGE_kmod-fs-nfs-common=n
CONFIG_PACKAGE_kmod-fs-vfat=n
CONFIG_PACKAGE_kmod-fs-exfat=n
CONFIG_PACKAGE_kmod-fs-ntfs3=n

# =============================================================================
#  砍掉系统信息/调频/自动挂载
# =============================================================================
CONFIG_PACKAGE_autocore=n
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_cpufreq=n
CONFIG_PACKAGE_luci-app-cpufreq=n

# =============================================================================
#  砍掉无关驱动
# =============================================================================
CONFIG_PACKAGE_kmod-leds-pwm=n
CONFIG_PACKAGE_kmod-pwm=n
CONFIG_PACKAGE_kmod-hwmon-pwmfan=n
CONFIG_PACKAGE_kmod-bluetooth=n
CONFIG_PACKAGE_kmod-sound-core=n
CONFIG_PACKAGE_kmod-input-core=n
CONFIG_PACKAGE_kmod-i2c-core=n
CONFIG_PACKAGE_kmod-spi-nor=n

# =============================================================================
#  砍掉用不上的 LuCI 应用
# =============================================================================
CONFIG_PACKAGE_luci-app-attendedsysupgrade=n
CONFIG_PACKAGE_luci-app-commands=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-ttyd=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_luci-app-nlbwmon=n
CONFIG_PACKAGE_luci-app-vnstat2=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-rclone=n
CONFIG_PACKAGE_luci-app-zerotier=n
CONFIG_PACKAGE_luci-app-tailscale=n
CONFIG_PACKAGE_luci-app-openlist2=n
CONFIG_PACKAGE_luci-app-qbittorrent=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-nps=n

# =============================================================================
#  必须关掉：passwall 的 INCLUDE_ 是「悬空配置」，会拉起 rust + 塞一堆代理核心
# =============================================================================
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Brook=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Kcptun=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Tuic_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ChinaDNS_NG=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_DNS2SOCKS=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_PDNSD=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_MicroSocks=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n

# =============================================================================
#  砍掉其它代理插件（只要 OpenClash）和它们会带来的核心
# =============================================================================
CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-momo=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-v2raya=n
CONFIG_PACKAGE_luci-app-v2ray-server=n
CONFIG_PACKAGE_luci-app-shadow-tls=n
CONFIG_PACKAGE_xray-core=n
CONFIG_PACKAGE_v2ray-core=n
CONFIG_PACKAGE_v2ray-geoip=n
CONFIG_PACKAGE_v2ray-geosite=n
CONFIG_PACKAGE_sing-box=n
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=n
CONFIG_PACKAGE_shadowsocks-libev-ss-local=n
CONFIG_PACKAGE_shadowsocks-rust-sslocal=n
CONFIG_PACKAGE_shadowsocks-rust-ssserver=n
CONFIG_PACKAGE_trojan-plus=n
CONFIG_PACKAGE_trojan-go=n
CONFIG_PACKAGE_naiveproxy=n
CONFIG_PACKAGE_hysteria=n
CONFIG_PACKAGE_tuic-client=n

# =============================================================================
#  ★★★ 必须关掉：RUBY_ENABLE_YJIT ← 这是 rust 被拉起的真正原因 ★★★
#
#  依赖链：luci-app-openclash 的 DEPENDS 里有 +ruby
#        → ruby 的 Makefile: PKG_BUILD_DEPENDS:=ruby/host RUBY_ENABLE_YJIT:rust/host
#        → ruby 的 Config.in:  default y if x86_64||aarch64   ← 我们是 aarch64，默认开！
#        → rust/host 需要下载 LLVM（约 1GB），从 CI 拉取失败：
#          "curl: (22) The requested URL returned error: 404"
#          "ERROR: failed to download llvm from ci"
#
#  所以关 rust 包本身没用，必须关 YJIT 这个开关。
#  YJIT 是 Ruby 的 JIT 加速，OpenClash 的 LuCI 界面完全不需要它。
# =============================================================================
# CONFIG_RUBY_ENABLE_YJIT is not set
CONFIG_RUBY_ENABLE_YJIT=n

# =============================================================================
#  砍掉 rust 工具链和会拉 rust 的大件
# =============================================================================
CONFIG_PACKAGE_rust=n
CONFIG_PACKAGE_rust-std=n
CONFIG_RUST=n
CONFIG_PACKAGE_jool=n
CONFIG_PACKAGE_openvswitch=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_librespeed-cli-rust=n
CONFIG_PACKAGE_rustdesk-server=n
CONFIG_PACKAGE_rust-bindgen=n
CONFIG_PACKAGE_python3-setuptools-rust=n

# =============================================================================
#  砍掉内存杀手 / 大件服务
# =============================================================================
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_containerd=n
CONFIG_PACKAGE_zerotier=n
CONFIG_PACKAGE_tailscale=n
CONFIG_PACKAGE_qbittorrent=n
CONFIG_PACKAGE_aria2=n
CONFIG_PACKAGE_minidlna=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_vsftpd=n
CONFIG_PACKAGE_nano=n
# OpenClash 脚本含 bashism；必须显式保留 bash。
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_python3=n
CONFIG_PACKAGE_node=n
CONFIG_PACKAGE_php8=n

# =============================================================================
#  内核可裁剪项（减小内核体积，腾出内存给用户态）
# =============================================================================
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_MODULE_SIG=n
CONFIG_KERNEL_SWAP=n
CONFIG_KERNEL_IPV6=y
CONFIG_KERNEL_BRIDGE=y
CONFIG_KERNEL_VETH=y
CONFIG_KERNEL_TUN=y
CONFIG_KERNEL_NF_TABLES=y

# 注意：KALLSYMS_ALL 依赖 KALLSYMS，两个必须同时开，不能一个开一个关
# 保留符号表 → panic 时显示函数名而不是裸地址，是排查的关键
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_KALLSYMS_ALL=y

# =============================================================================
#  日志能力：只保留当前源码树能识别、且可以后续实测验证的项。
# =============================================================================
# 注：NETCONSOLE/PSTORE_RAM/PANIC_TIMEOUT 等裸 KERNEL_* 行在本树未声明，
# defconfig 会丢弃；不在这里假装启用。模块装入也不等于已配置日志后端。
# netconsole 需要 kmod-netconsole + 正确初始化；ramoops 需要 DTS 保留内存，
# 当前 DTS 的 0x50d00000 在 256MB 物理内存外，不作为可靠日志后端宣称。

CONFIG_KERNEL_PRINTK=y
CONFIG_KERNEL_PRINTK_TIME=y
CONFIG_KERNEL_DYNAMIC_DEBUG=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_MAGIC_SYSRQ=y

CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_kmod-nf-log=y
CONFIG_PACKAGE_kmod-nf-log6=y

# 仅保留模块，后续还需 DTS 参数与实际测试，不能据此宣称 panic 日志可保存。
CONFIG_PACKAGE_kmod-pstore=y
CONFIG_PACKAGE_kmod-ramoops=y
CONFIG_PACKAGE_kmod-reed-solomon=y

CONFIG_PACKAGE_ucode=y
CONFIG_PACKAGE_ucode-mod-fs=y
CONFIG_PACKAGE_ucode-mod-uci=y
